@using ManualTesting.Client
@using ManualTesting.Client.Services
@using Microsoft.AspNetCore.Components.Web

@namespace ManualTesting.ClientHost

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>NoJsBlazor Test</title>
        <base href="/">

        @* Favicon *@
        <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
        <link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png" />
        <link rel="shortcut icon" href="/favicon/favicon.ico" />
        @* IOS Safari *@
        <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
        @* Android home screen and PWA *@
        <link rel="manifest" href="/favicon/webmanifest.json" />

        <link rel="stylesheet" href="/_content/NoJsBlazor/style.min.css">
        <link rel="stylesheet" href="/site.css">

        <script src="/site.js" defer></script>
        @if (renderMode is not null) {
            <script src="/_framework/blazor.web.js" defer></script>
        }
        else
        {
            <script src="/_framework/blazor.webassembly.js" defer></script>
        }
    </head>

    <body>
        <div id="anchor">
            @{
                __builder.OpenComponent<Client.IApp>(0);
                __builder.AddComponentRenderMode(renderMode);
                __builder.CloseComponent();
            }
        </div>

        <div id="blazor-error-ui">
            <div>
                <p><span>An unexpected error has occurred.</span><span><a href="/" class="reload">Reload Website</a> if not working as expected.</span></p>
                <svg class="dismiss" role="button" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10">
                    <line x1="2" y1="2" x2="8" y2="8" />
                    <line x1="2" y1="8" x2="8" y2="2" />
                </svg>
            </div>
        </div>
    </body>
</html>
