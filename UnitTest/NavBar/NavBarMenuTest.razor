@namespace UnitTest
@inherits BunitContext

@code {
    private (IRenderedComponent<ContainerFragment> fragment, NavBar navBar, NavBarMenu navBarMenu, NavBarItem navBarItem) RenderNavBarTree(MarkupString headHtml) {
        NavBar navBar = null!;
        NavBarMenu navBarMenu = null!;
        NavBarItem navBarItem = null!;

        IRenderedComponent<ContainerFragment> fragment = Render(
            @<NavBar @ref="navBar">
                <Items>
                    <NavBarMenu @ref="navBarMenu">
                        <Head>
                            @headHtml
                        </Head>
                        <Items>
                            <NavBarItem @ref="navBarItem">Item</NavBarItem>
                        </Items>
                    </NavBarMenu>
                </Items>
            </NavBar>
            );

        return (fragment, navBar, navBarMenu, navBarItem);
    }

    private (IRenderedComponent<ContainerFragment> fragment, NavBar navBar, NavBarMenu navBarMenu, NavBarItem navBarItem) RenderNavBarWithCallback(Action<bool> eventCallback) {
        NavBar navBar = null!;
        NavBarMenu navBarMenu = null!;
        NavBarItem navBarItem = null!;

        IRenderedComponent<ContainerFragment> fragment = Render(
            @<NavBar @ref="navBar">
                <Items>
                    <NavBarMenu @ref="navBarMenu" OnToggle="eventCallback">
                        <Head>
                            Head
                        </Head>
                        <Items>
                            <NavBarItem @ref="navBarItem">Item</NavBarItem>
                        </Items>
                    </NavBarMenu>
                </Items>
            </NavBar>
            );

        return (fragment, navBar, navBarMenu, navBarItem);
    }
}
