@namespace UnitTest
@inherits BunitContext

@code {
    private IRenderedComponent<ContainerFragment> RenderCarouselWithOneItem(MarkupString childcontent) => Render(
        @<Carousel>
            <Items>
                <CarouselItem>
                    @childcontent
                </CarouselItem>
            </Items>
        </Carousel>
        );
}
